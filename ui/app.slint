import { Button, ComboBox, LineEdit, ListView, TextEdit, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

export struct Entry { name: string, detail: string, kind: string, modified: string, size-key: string, modified-key: string, directory: bool, link: bool, thumbnail: image, has-thumbnail: bool }
export component App inherits Window {
    // The application uses a fixed light background, so its widgets must use
    // the matching palette even when the operating system is in dark mode.
    init => { Palette.color-scheme = ColorScheme.light; }
    title: "Salt · SMB 客户端";
    preferred-width: 1120px; preferred-height: 760px;
    background: #f4f5f8;
    in-out property <string> server: "";
    in-out property <string> share: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> current-path: "";
    in-out property <string> status: "输入服务器和共享名称以连接";
    in-out property <string> selected: "";
    in-out property <bool> selected-directory: false;
    in-out property <bool> connected: false;
    in-out property <bool> show-connection: true;
    in-out property <bool> busy: false;
    in-out property <string> preview-text: "";
    in-out property <image> preview-image;
    in-out property <bool> showing-image: false;
    private property <bool> preview-visible: root.selected != "" && !root.selected-directory;
    private property <float> preview-ratio: 0.4;
    in property <[Entry]> entries;
    in-out property <int> listing-generation: 0;
    in-out property <int> sort-index: 0;
    in-out property <bool> sort-descending: false;
    in-out property <bool> icon-view: false;
    in-out property <float> list-scale: 1;
    in-out property <float> icon-scale: 1;
    in-out property <bool> renaming: false;
    in-out property <string> rename-source: "";
    in-out property <string> rename-value: "";
    callback rename-request(string, string);
    callback delete-request(string, bool, bool);
    function zoom(delta: length) {
        if root.icon-view { root.icon-scale = clamp(root.icon-scale + clamp(delta / 120px, -1, 1) * 0.1, 0.6, 2.0); }
        else { root.list-scale = clamp(root.list-scale + clamp(delta / 120px, -1, 1) * 0.1, 0.6, 2.0); }
    }
    callback sort-changed();
    callback thumbnail-request(string, int, int);
    callback generation-changed(int);
    changed listing-generation => { root.generation-changed(root.listing-generation); }
    in property <[string]> history-labels: ["选择历史连接"];
    in-out property <int> history-index: 0;
    callback connect-request(string, string, string, string);
    callback select-history(int);
    callback delete-history(int);
    callback navigate(string);
    callback upload();
    callback download(string);
    callback preview(string);

    VerticalBox {
        padding: 24px; spacing: 14px;
        HorizontalBox {
            spacing: 12px;
            Rectangle {
                width: 42px; height: 42px; border-radius: 12px; background: #445fe8;
                Text { text: "S"; color: white; font-size: 22px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            VerticalBox {
                spacing: 2px; horizontal-stretch: 1;
                Text { text: "Salt"; font-size: 22px; font-weight: 700; color: #1c2435; }
                Text { text: "SMB 文件工作台"; font-size: 12px; color: #8992a3; }
            }
            Text { text: root.connected ? "●  已连接" : "○  未连接"; color: root.connected ? #27876d : #8992a3; font-size: 13px; vertical-alignment: center; }
            if root.connected: Button { text: root.show-connection ? "收起连接" : "切换连接"; enabled: !root.busy; clicked => { root.show-connection = !root.show-connection; } }
        }
        if root.show-connection: Rectangle {
            background: white; border-radius: 12px;
            VerticalBox {
                padding: 16px; spacing: 10px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "连接到服务器"; font-size: 14px; font-weight: 700; color: #273248; horizontal-stretch: 1; }
                    Text { text: "SMB / 网络共享"; font-size: 12px; color: #9aa3b2; }
                }
                HorizontalBox {
                    spacing: 8px;
                    LineEdit { placeholder-text: "服务器或 IP（可带端口）"; text <=> root.server; enabled: !root.busy; }
                    LineEdit { placeholder-text: "共享名称"; text <=> root.share; enabled: !root.busy; }
                    LineEdit { placeholder-text: "用户名"; text <=> root.username; enabled: !root.busy; }
                    LineEdit { placeholder-text: "密码"; text <=> root.password; input-type: InputType.password; enabled: !root.busy; }
                    Button { text: "连接"; enabled: !root.busy; clicked => { root.connect-request(root.server, root.share, root.username, root.password); } }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "历史连接"; vertical-alignment: center; color: #778296; font-size: 12px; }
                    ComboBox {
                        model: root.history-labels; current-index <=> root.history-index;
                        enabled: !root.busy && root.history-labels.length > 1; horizontal-stretch: 1;
                        selected(value) => { if self.current-index > 0 { root.select-history(self.current-index - 1); } }
                    }
                    Button { text: "删除记录"; enabled: !root.busy && root.history-index > 0; clicked => { root.delete-history(root.history-index - 1); } }
                }
            }
        }
        HorizontalBox {
            spacing: 8px;
            Button { text: "← 上一级"; enabled: root.connected && !root.busy && root.current-path != ""; clicked => { root.navigate(".."); } }
            Button { text: "刷新"; enabled: root.connected && !root.busy; clicked => { root.navigate("."); } }
            Rectangle {
                background: #e9ecf3; border-radius: 6px; horizontal-stretch: 1;
                Text { x: 12px; width: parent.width - 24px; text: "/" + root.current-path; vertical-alignment: center; color: #536079; font-size: 13px; overflow: elide; }
            }
            Button { text: "上传文件"; enabled: root.connected && !root.busy; clicked => { root.upload(); } }
            Button { text: "下载"; enabled: root.connected && !root.busy && root.selected != "" && !root.selected-directory; clicked => { root.download(root.selected); } }
            Button { text: "预览"; enabled: root.connected && !root.busy && root.selected != "" && !root.selected-directory; clicked => { root.preview(root.selected); } }
        }
        content := Rectangle {
            vertical-stretch: 1;
            min-width: root.preview-visible ? 530px : 276px;
            min-height: 240px;
            private property <length> panel-width: self.width - 16px - (root.preview-visible ? 14px : 0px);
            private property <length> file-width: root.preview-visible
                ? clamp(self.panel-width * (1 - root.preview-ratio), 260px, self.panel-width - 240px)
                : self.panel-width;
            Rectangle {
                x: 8px; y: 8px; width: content.file-width; height: content.height - 16px;
                background: white; border-radius: 12px;
                VerticalBox {
                    padding: 16px; spacing: 10px;
                    HorizontalBox {
                        Text { text: "文件"; color: #273248; font-size: 15px; font-weight: 700; horizontal-stretch: 1; }
                        Text { text: root.entries.length + " 项"; color: #8992a3; font-size: 12px; vertical-alignment: center; }
                        ComboBox { model: ["名称", "类型", "大小", "修改时间"]; current-index <=> root.sort-index; selected(value) => { root.sort-changed(); } }
                        Button { text: root.sort-descending ? "降序 ↓" : "升序 ↑"; clicked => { root.sort-descending = !root.sort-descending; root.sort-changed(); } }
                        Button { text: root.icon-view ? "列表视图" : "图标视图"; clicked => { root.icon-view = !root.icon-view; } }
                    }
                    Rectangle { height: 1px; background: #eef0f4; }
                    if root.entries.length == 0: Rectangle {
                        vertical-stretch: 1;
                        Text { text: root.connected ? "此文件夹为空" : "连接服务器后浏览文件"; color: #a0a9b8; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.entries.length > 0 && !root.icon-view: HorizontalLayout {
                        padding-left: 80px; padding-right: 14px;
                        Text { text: "名称"; color: #8992a3; horizontal-stretch: 1; }
                        Text { text: "类型"; color: #8992a3; width: 110px; }
                        Text { text: "大小"; color: #8992a3; width: 90px; }
                        Text { text: "修改时间"; color: #8992a3; width: 145px; }
                    }
                    if root.entries.length > 0 && !root.icon-view: ListView {
                        for entry[index] in root.entries: Rectangle {
                            height: 76px * root.list-scale; border-radius: 8px;
                            background: root.selected == entry.name ? #edf1ff : row-touch.has-hover ? #f6f7fa : white;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 14px; spacing: 14px;
                                Rectangle {
                                    width: 56px * root.list-scale; height: 56px * root.list-scale; border-radius: 9px;
                                    background: entry.directory ? #fff4dc : #eef1f8;
                                    if entry.has-thumbnail: Image { x: 4px; y: 4px; width: 48px * root.list-scale; height: 48px * root.list-scale; source: entry.thumbnail; image-fit: contain; }
                                    if !entry.has-thumbnail: Text {
                                        text: entry.directory ? "▰" : "▤"; font-size: 30px * root.list-scale;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        color: entry.directory ? #e6a63a : #7c8dab;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px; horizontal-stretch: 1;
                                    Text { text: entry.name; color: #273248; font-size: 14px; font-weight: 600; vertical-alignment: bottom; overflow: elide; }
                                    Text { text: entry.directory ? "文件夹" : "文件"; color: #a0a9b8; font-size: 12px; }
                                }
                                Text { text: entry.kind; color: #7c8799; font-size: 12px; width: 96px; vertical-alignment: center; overflow: elide; }
                                Text { text: entry.detail; color: #7c8799; font-size: 12px; width: 76px; vertical-alignment: center; }
                                Text { text: entry.modified; color: #7c8799; font-size: 12px; width: 145px; vertical-alignment: center; }
                            }
                            init => { if !entry.directory && !entry.has-thumbnail { root.thumbnail-request(entry.name, index, root.listing-generation); } }
                            row-menu := ContextMenuArea {
                                enabled: !root.busy;
                                Menu {
                                    MenuItem { title: "打开文件夹"; enabled: entry.directory; activated => { root.navigate(entry.name); } }
                                    MenuItem { title: "预览"; enabled: !entry.directory; activated => { root.selected = entry.name; root.selected-directory = false; root.preview(entry.name); } }
                                    MenuItem { title: "下载"; enabled: !entry.directory; activated => { root.download(entry.name); } }
                                    MenuSeparator { }
                                    MenuItem { title: "重命名"; activated => { root.rename-source = entry.name; root.rename-value = entry.name; root.renaming = true; } }
                                    MenuItem { title: "删除"; activated => { root.delete-request(entry.name, entry.directory, entry.link); } }
                                    MenuSeparator { }
                                    MenuItem { title: "刷新"; activated => { root.navigate("."); } }
                                }
                            row-touch := TouchArea {
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && !root.busy {
                                        row-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                    }
                                }
                                scroll-event(event) => { if (event.modifiers.control || event.modifiers.meta) && event.delta-y != 0px { root.zoom(event.delta-y); return EventResult.accept; } return EventResult.reject; }
                                clicked => {
                                    if !root.busy {
                                        root.selected = entry.name;
                                        root.selected-directory = entry.directory;
                                        if !entry.directory { root.preview(entry.name); }
                                    }
                                }
                                double-clicked => { if entry.directory && !root.busy { root.navigate(entry.name); } }
                            }
                            }
                        }
                    }
                    if root.entries.length > 0 && root.icon-view: grid := ListView {
                        property <int> columns: max(1, floor(self.width / (150px * root.icon-scale)));
                        for row in ceil(root.entries.length / self.columns): Rectangle {
                            height: 156px * root.icon-scale;
                            for col in grid.columns: Rectangle {
                                property <int> entry-index: row * grid.columns + col;
                                changed entry-index => {
                                    if entry-index < root.entries.length && !root.entries[entry-index].directory && !root.entries[entry-index].has-thumbnail {
                                        root.thumbnail-request(root.entries[entry-index].name, entry-index, root.listing-generation);
                                    }
                                }
                                if entry-index < root.entries.length: Rectangle {
                                    x: col * 150px * root.icon-scale; width: 142px * root.icon-scale; height: 150px * root.icon-scale; border-radius: 8px;
                                    background: root.selected == root.entries[entry-index].name ? #edf1ff : tile-touch.has-hover ? #f6f7fa : white;
                                    VerticalLayout {
                                        padding: 8px; spacing: 4px;
                                        Rectangle {
                                            width: 76px * root.icon-scale; height: 76px * root.icon-scale; border-radius: 9px;
                                            background: root.entries[entry-index].directory ? #fff4dc : #eef1f8;
                                            if root.entries[entry-index].has-thumbnail: Image { width: 68px * root.icon-scale; height: 68px * root.icon-scale; source: root.entries[entry-index].thumbnail; image-fit: contain; }
                                            if !root.entries[entry-index].has-thumbnail: Text {
                                                text: root.entries[entry-index].directory ? "▰" : "▤"; font-size: 38px * root.icon-scale;
                                                color: root.entries[entry-index].directory ? #e6a63a : #7c8dab;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                        Text { text: root.entries[entry-index].name; color: #273248; font-size: 12px; horizontal-alignment: center; overflow: elide; }
                                        Text { text: root.entries[entry-index].directory ? "文件夹" : root.entries[entry-index].detail; color: #8992a3; font-size: 11px; horizontal-alignment: center; }
                                    }
                                    init => { if !root.entries[entry-index].directory && !root.entries[entry-index].has-thumbnail { root.thumbnail-request(root.entries[entry-index].name, entry-index, root.listing-generation); } }
                                    tile-menu := ContextMenuArea {
                                enabled: !root.busy;
                                Menu {
                                    MenuItem { title: "打开文件夹"; enabled: root.entries[entry-index].directory; activated => { root.navigate(root.entries[entry-index].name); } }
                                    MenuItem { title: "预览"; enabled: !root.entries[entry-index].directory; activated => { root.selected = root.entries[entry-index].name; root.selected-directory = false; root.preview(root.entries[entry-index].name); } }
                                    MenuItem { title: "下载"; enabled: !root.entries[entry-index].directory; activated => { root.download(root.entries[entry-index].name); } }
                                    MenuSeparator { }
                                    MenuItem { title: "重命名"; activated => { root.rename-source = root.entries[entry-index].name; root.rename-value = root.entries[entry-index].name; root.renaming = true; } }
                                    MenuItem { title: "删除"; activated => { root.delete-request(root.entries[entry-index].name, root.entries[entry-index].directory, root.entries[entry-index].link); } }
                                    MenuSeparator { }
                                    MenuItem { title: "刷新"; activated => { root.navigate("."); } }
                                }
                                    tile-touch := TouchArea {
                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && !root.busy {
                                                tile-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                            }
                                        }
                                scroll-event(event) => { if (event.modifiers.control || event.modifiers.meta) && event.delta-y != 0px { root.zoom(event.delta-y); return EventResult.accept; } return EventResult.reject; }
                                        clicked => { if !root.busy { root.selected = root.entries[entry-index].name; root.selected-directory = root.entries[entry-index].directory; if !root.selected-directory { root.preview(root.selected); } } }
                                        double-clicked => { if root.entries[entry-index].directory && !root.busy { root.navigate(root.entries[entry-index].name); } }
                                    }
                            }
                                }
                            }
                        }
                    }
                }
            }
            if root.preview-visible: Rectangle {
                x: 8px + content.file-width; y: 8px; width: 14px; height: content.height - 16px;
                Rectangle {
                    width: 3px; height: min(64px, parent.height); border-radius: 2px;
                    background: resize-touch.pressed || resize-touch.has-hover ? #445fe8 : #cbd2df;
                }
                resize-touch := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        if self.pressed {
                            root.preview-ratio = clamp(1 - (
                                self.absolute-position.x + self.mouse-x - self.pressed-x
                                - content.absolute-position.x - 8px
                            ) / content.panel-width, 240px / content.panel-width, 1 - 260px / content.panel-width);
                        }
                    }
                }
            }
            if root.preview-visible: Rectangle {
                x: 8px + content.file-width + 14px; y: 8px;
                width: content.panel-width - content.file-width; height: content.height - 16px;
                background: white; border-radius: 12px;
                VerticalBox {
                    padding: 16px; spacing: 10px;
                    Text { text: "预览"; color: #273248; font-size: 15px; font-weight: 700; }
                    Text { text: root.selected; color: #9aa3b2; font-size: 12px; overflow: elide; }
                    Rectangle { height: 1px; background: #eef0f4; }
                    if root.showing-image: Image { source: root.preview-image; image-fit: contain; vertical-stretch: 1; }
                    if !root.showing-image: TextEdit { text: root.preview-text; read-only: true; vertical-stretch: 1; }
                }
            }
        }
        HorizontalBox {
            spacing: 7px;
            Text { text: "●"; color: root.busy ? #e6a63a : root.connected ? #36a581 : #b5becb; font-size: 9px; vertical-alignment: center; }
            Text { text: root.status; color: #7c8799; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
        }
    }
    if root.renaming: Rectangle {
        background: #00000066;
        TouchArea { }
        Rectangle {
            width: 400px; height: 168px; border-radius: 12px; background: white;
            VerticalLayout {
                padding: 18px; spacing: 12px;
                Text { text: "重命名"; color: #273248; font-size: 16px; font-weight: 700; }
                LineEdit { text <=> root.rename-value; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    Button { text: "取消"; clicked => { root.renaming = false; } }
                    Button { text: "确定"; enabled: root.rename-value != ""; clicked => { root.renaming = false; root.rename-request(root.rename-source, root.rename-value); } }
                }
            }
        }
    }

}
